<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/analyticsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Analytics"
            android:textColor="@color/zone_text_primary"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/heartRateLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Current Heart Rate"
            android:textColor="@color/zone_text_secondary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/heartRateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="--"
            android:textColor="@color/zone_text_primary"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="BPM"
            android:textColor="@color/zone_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/heartRateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/heart_rate_no_reading"
            android:textColor="@color/zone_text_secondary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="@string/heart_rate_range_note"
            android:textColor="@color/zone_text_secondary"
            android:textSize="12sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/reading_details_background"
            android:columnCount="3"
            android:padding="14dp"
            android:rowCount="2">

            <TextView
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Resting"
                android:textColor="@color/zone_text_secondary" />
            <TextView
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Minimum"
                android:textColor="@color/zone_text_secondary" />
            <TextView
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="Maximum"
                android:textColor="@color/zone_text_secondary" />

            <TextView
                android:id="@+id/restingHeartRateValue"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="--"
                android:textColor="@color/zone_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/minHeartRateValue"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="--"
                android:textColor="@color/zone_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/maxHeartRateValue"
                android:layout_columnWeight="1"
                android:gravity="center"
                android:text="--"
                android:textColor="@color/zone_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </GridLayout>

        <TextView
            android:id="@+id/graphLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Heart Rate During Session"
            android:textColor="@color/zone_text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/heartRateChart"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/device_list_background" />

        <Button
            android:id="@+id/recommendedStudyTimesButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/recommended_study_times_btn" />

        <Button
            android:id="@+id/previousSessionsButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Session History" />

        <Button
            android:id="@+id/mainMenuButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Return to Main Menu" />
    </LinearLayout>
</ScrollView>
