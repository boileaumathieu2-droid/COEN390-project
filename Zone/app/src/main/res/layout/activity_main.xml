<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/dailyObjectiveText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Daily Objectives"
            android:textColor="@color/zone_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/dailyGoalsListView"
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/goalPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minHeight="54dp"
            android:padding="8dp"
            android:text="You have not set any goals for today. Set your study session goal here."
            android:textColor="@color/zone_text_primary"
            android:textSize="17sp" />

        <Button
            android:id="@+id/objectivesButton"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Calendar / Objectives"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/studyTipTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Study Tip: A study tip will be displayed here"
            android:textColor="@color/zone_text_primary" />

        <Button
            android:id="@+id/timerSettings"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Timer Settings" />

        <Button
            android:id="@+id/gradesTrackerButton"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Grades Tracker" />

        <Button
            android:id="@+id/analyticsButton"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Analytics" />

        <Button
            android:id="@+id/launchTimerButton"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Open Timer"
            android:backgroundTint="@color/zone_primary" />

    </LinearLayout>
</ScrollView>
